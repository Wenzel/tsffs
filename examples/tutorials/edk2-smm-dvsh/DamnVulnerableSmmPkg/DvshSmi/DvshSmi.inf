  MdeModulePkg/MdeModulePkg.dec
  DamnVulnerableSmmPkg/DamnVulnerableSmmPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  PrintLib
  SerialPortLib
  BaseMemoryLib
  MemoryAllocationLib
  SmmServicesTableLib

[Guids]
  gDvshSmiHandlerGuid       ## PRODUCES

[Depex.common]
