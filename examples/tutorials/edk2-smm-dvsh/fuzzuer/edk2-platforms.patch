diff --git a/Platform/Intel/SimicsOpenBoardPkg/SimicsPei/MemDetect.c b/Platform/Intel/SimicsOpenBoardPkg/SimicsPei/MemDetect.c
index c680aeb..4a3ce13 100644
--- a/Platform/Intel/SimicsOpenBoardPkg/SimicsPei/MemDetect.c
+++ b/Platform/Intel/SimicsOpenBoardPkg/SimicsPei/MemDetect.c
@@ -366,6 +366,19 @@ PublishPeiMemory (
     MemoryBase = mS3Supported && FeaturePcdGet (PcdSmmSmramRequire) ?
       PcdGet32 (PcdSimicsDecompressionScratchEnd) :
       PcdGet32 (PcdSimicsDxeMemFvBase) + PcdGet32 (PcdSimicsDxeMemFvSize);
+    //
+    // PEI memory must not span the ASan shadow, which is published as its own
+    // reserved range in QemuInitializeRam (DXE needs the PHIT range inside one
+    // system memory resource).
+    //
+    if ((GetSystemMemorySizeBelow4gb () >> 3) != 0) {
+      UINT64  ShadowEnd;
+
+      ShadowEnd = 0x5000000ULL + (GetSystemMemorySizeBelow4gb () >> 3);
+      if ((MemoryBase < ShadowEnd) && (ShadowEnd < LowerMemorySize)) {
+        MemoryBase = ShadowEnd;
+      }
+    }
     MemorySize = LowerMemorySize - MemoryBase;
   }
   DEBUG((EFI_D_INFO, "MemoryBase=0x%lx MemorySize=0x%lx\n", MemoryBase, MemorySize));
@@ -438,7 +451,24 @@ QemuInitializeRam (
       UINT32 TsegSize;
 
       TsegSize = mX58TsegMbytes * SIZE_1MB;
-      AddMemoryRangeHob (BASE_1MB, LowerMemorySize - TsegSize);
+      //
+      // The ASan shadow gets its own reserved range. Left inside the system memory
+      // range below, DXE reports it as free memory, and with restricted SMM memory
+      // access the SMM page tables mark free memory not present: the first
+      // instrumented SMM access then faults reading its shadow byte.
+      //
+      if (((UINT64)(LowerMemorySize >> 3) != 0) &&
+          (0x5000000ULL + (LowerMemorySize >> 3) <= (UINT64)(LowerMemorySize - TsegSize))) {
+        //
+        // One page of shared ASan state sits in front of the shadow, in the same
+        // reserved range, so SMM can read it under restricted memory access.
+        //
+        AddMemoryRangeHob (BASE_1MB, 0x5000000 - SIZE_4KB);
+        AddReservedMemoryBaseSizeHob (0x5000000 - SIZE_4KB, SIZE_4KB + (LowerMemorySize >> 3), TRUE);
+        AddMemoryRangeHob (0x5000000 + (LowerMemorySize >> 3), LowerMemorySize - TsegSize);
+      } else {
+        AddMemoryRangeHob (BASE_1MB, LowerMemorySize - TsegSize);
+      }
       AddReservedMemoryBaseSizeHob (LowerMemorySize - TsegSize, TsegSize,
         TRUE);
 
@@ -585,6 +615,14 @@ InitializeRamRegions (
       //
       // Build HOB for AsanInfo
       //
+      // ASAN_INFO has grown fields (fuzzing window, protected regions, untrusted
+      // buffers) since this code was written; they must start out zero, the window closed.
+      ZeroMem (&AsanInfo, sizeof (ASAN_INFO));
+      AsanInfo.AsanSharedInfo = 0;
+      if (AsanShadowMemoryStart == 0x5000000) {
+        ZeroMem ((VOID *)(UINTN)(AsanShadowMemoryStart - SIZE_4KB), SIZE_4KB);
+        AsanInfo.AsanSharedInfo = AsanShadowMemoryStart - SIZE_4KB;
+      }
       AsanInfo.AsanShadowMemorySize = AsanShadowMemorySize;
       AsanInfo.AsanShadowMemoryStart = AsanShadowMemoryStart;
       AsanInfo.AsanInited = 1;
