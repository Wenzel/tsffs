# Step toggles (DVSH_PT_PROTECT, DVSH_ASAN: TRUE or FALSE), generated by build.sh.
!include $(BOARD_PKG)/BoardX58Ich10/DvshStep.dsc.inc

# The bundled UBSan runtime has no handler for bool, nonnull-attribute,
# returns-nonnull-attribute, builtin or vla-bound, so those checks stay off (they
# would fail to link).
# Instrumentation for DvshSmi. The platform default is what every other module gets
# (no -fsanitize), so DVSH_ASAN=FALSE is the control: same tree, same toolchain.
!if $(DVSH_ASAN) == TRUE
  DEFINE DVSH_SAN_FLAGS = -fsanitize=address -fno-sanitize-address-use-after-scope -mllvm -asan-stack-dynamic-alloca=0 -mllvm -asan-instrumentation-with-call-threshold=0 -mllvm -asan-force-dynamic-shadow=true -fsanitize=undefined -fno-sanitize=alignment,bool,nonnull-attribute,returns-nonnull-attribute,builtin,vla-bound -Wno-frame-address
!else
  DEFINE DVSH_SAN_FLAGS = -mllvm -asan-stack=0
!endif
